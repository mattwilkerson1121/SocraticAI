{
  "name": "socratic-ai-backend",
  "version": "1.0.0",
  "description": "SocraticAI Backend - Node.js Express API with Supabase & OpenAI",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "supabase migration list",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull"
  },
  "keywords": [
    "socratic",
    "ai",
    "critical-thinking",
    "saas"
  ],
  "author": "SocraticAI Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "js-tiktoken": "^1.0.12",
    "mammoth": "^1.6.0",
    "multer": "^2.4.0",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.3.0",
    "supabase": "^1.127.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
